<!--
LBAC Order of Service Report
Version 2.1

CURRENTLY DYNAMIC
- Service Date
- Worship Leader
- Song Titles
- Song of Anticipation Arrangement Name

CURRENTLY HARD CODED
- Theme/Greeting
- Mission's Moment
- Prayer for the Church/Offering
- Message
- Announcements/Benediction
- Service Notes

FUTURE IMPLEMENTATION IDEAS

Message Title:
{{ plan.plan_title }}

Preacher:
Lookup plan person assigned to position "Preacher"

Prayer Leader:
Lookup plan person assigned to position "Prayer"

Mission's Moment:
Lookup plan person assigned to position "Mission's Moment"

Announcements/Benediction:
Lookup plan person assigned to position "Announcements"

Potential future improvement:
Use a dedicated note category instead of Description
to identify:
- Song of Anticipation
- Mission's Moment
- Announcements
- Special Elements
-->

{% comment %}
Extract key data from plan.
{% endcomment %}

{% assign worship_leader = "" %}
{% assign anticipation_title = "" %}
{% assign anticipation_arrangement = "" %}
{% assign last_song_title = "" %}
{% assign first_song_title = "" %}
{% assign first_song_found = false %}

{% for plan_person in plan.plan_people_not_declined %}
  {% if plan_person.position == "Worship Leader" %}
    {% assign worship_leader = plan_person.person.name %}
    {% break %}
  {% endif %}
{% endfor %}

{% for item in plan.items %}
  {% if item.song or item.arrangement %}
    
    {% if first_song_found == false %}
      {% assign first_song_title = item.title %}
      {% assign first_song_found = true %}
    {% endif %}
    
    {% if item.description contains "Song of Anticipation" %}
      {% assign anticipation_title = item.title %}
      {% if item.arrangement %}
        {% assign anticipation_arrangement = item.arrangement.name %}
      {% endif %}
    {% endif %}
    
    {% assign last_song_title = item.title %}
  {% endif %}
{% endfor %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order of Service</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Calibri, Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.5;
      margin: 0.5in;
      color: #000;
    }

    .page-title {
      text-align: center;
      font-size: 14pt;
      font-weight: bold;
      margin-bottom: 1.25rem;
    }

    .service-section {
      margin-top: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .section-heading {
      font-weight: normal;
    }

    .song-title {
      margin-left: 2.5rem;
      font-style: italic;
    }

    .subnote {
      margin-left: 2.5rem;
      font-size: 0.95rem;
      color: #333;
    }

    .service-notes {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #ccc;
    }

    @media print {
      body {
        margin: 0.5in;
      }
      .service-section {
        page-break-inside: avoid;
      }
      .song-title {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>

  <div class="page-title">
    Order of Service • {% if plan.plan_times.size > 0 %}{{ plan.plan_times.first.starts_at | date: "%B %-d, %Y" }}{% endif %}
  </div>

  <div class="service-section section-heading">
    Prelude • Call to Worship • Recorded Music
  </div>

  <div class="service-section section-heading">
    Worship in Singing • Worship Team
  </div>

  {% if first_song_title %}
    <div class="song-title">{{ first_song_title }}</div>
  {% endif %}

  <div class="service-section section-heading">
    {% if worship_leader %}
      Welcome to Worship • {{ worship_leader }}
    {% else %}
      Welcome to Worship •
    {% endif %}
  </div>

  <div class="subnote">
    (Theme/Greeting)
  </div>

  <div class="service-section section-heading">
    Songs of Worship • Worship Team
  </div>

  {% assign worship_song_count = 0 %}
  {% for item in plan.items %}
    {% if item.song or item.arrangement %}
      {% assign worship_song_count = worship_song_count | plus: 1 %}
      
      {% comment %}
      Display songs that are:
      - Not the first song (worship_song_count > 1)
      - Not the Song of Anticipation
      - Not the last song (Song of Response)
      {% endcomment %}
      {% if worship_song_count > 1 and item.title != anticipation_title and item.title != last_song_title %}
        <div class="song-title">{{ item.title }}</div>
      {% endif %}
    {% endif %}
  {% endfor %}

  <div class="service-section section-heading">
    Worship in Mission's Moment •
  </div>

  <div class="service-section section-heading">
    Prayer for the Church/Offering •
  </div>

  <div class="service-section section-heading">
    Song of Anticipation • Worship Team
  </div>

  {% if anticipation_title %}
    <div class="song-title">
      {{ anticipation_title }}
      {% if anticipation_arrangement %}
        , {{ anticipation_arrangement }}
      {% endif %}
    </div>
  {% endif %}

  <div class="service-section section-heading">
    Message: "" •
  </div>

  <div class="service-section section-heading">
    Song of Response • Worship Team
  </div>

  {% if last_song_title %}
    <div class="song-title">{{ last_song_title }}</div>
  {% endif %}

  <div class="service-section section-heading">
    Announcements/Benediction •
  </div>

  <div class="service-notes section-heading">
    Service Notes:
  </div>

</body>
</html>