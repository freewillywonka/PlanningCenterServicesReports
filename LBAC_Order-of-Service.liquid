<!--
LBAC Order of Service Report
Version 2.3

CURRENTLY DYNAMIC
- Service Date
- Worship Leader
- Song Titles
- Song of Anticipation Arrangement Name
- Platform Roles (Preacher, Prayer Leader, Announcements, Benediction, Mission's Moment, Communion Elder)

CURRENTLY HARD CODED
- Theme/Greeting
- Service Notes

PLATFORM ROLES FORMAT (add to Platform Team general note):
PLATFORM ROLES:
Preacher: Chris Lankford
Prayer Leader: TBD
Communion Elder: ""
Announcements: Hank McWatters
Benediction: Hank McWatters
Mission's Moment: 

IMPORTANT DISTINCTION:
- If a role title is NOT in the notes, that section won't appear in the output (the role isn't happening that week)
- If a role title IS in the notes but value is blank, TBD, or "", the section displays with "" to show it needs to be filled
-->

{% comment %}
Extract key data from plan.
{% endcomment %}

{% assign worship_leader = "" %}
{% assign anticipation_title = "" %}
{% assign anticipation_arrangement = "" %}
{% assign last_song_title = "" %}
{% assign first_song_title = "" %}
{% assign first_song_found = false %}

{% comment %}
Initialize platform roles
Flags indicate whether the role was found in the notes at all
{% endcomment %}
{% assign preacher = "" %}
{% assign preacher_found = false %}
{% assign prayer_leader = "" %}
{% assign prayer_leader_found = false %}
{% assign communion_elder = "" %}
{% assign communion_elder_found = false %}
{% assign announcements = "" %}
{% assign announcements_found = false %}
{% assign benediction = "" %}
{% assign benediction_found = false %}
{% assign missions_moment = "" %}
{% assign missions_moment_found = false %}

{% for plan_person in plan.plan_people_not_declined %}
  {% if plan_person.position == "Worship Leader" %}
    {% assign worship_leader = plan_person.person.name %}
    {% break %}
  {% endif %}
{% endfor %}

{% comment %}
Extract platform roles from plan general note (PLATFORM ROLES:)
{% endcomment %}
{% for note in plan.notes %}
 {% if note.category_name == "General" and note.note contains "PLATFORM ROLES:" %}
 {% assign roles_text = note.note %}
      
      {% comment %}
      Extract Preacher
      {% endcomment %}
      {% if roles_text contains "Preacher:" %}
        {% assign preacher_found = true %}
        {% assign preacher_raw = roles_text | split: "Preacher:" | last | split: "
" | first | strip %}
        {% if preacher_raw == "TBD" or preacher_raw == """" or preacher_raw == "" %}
          {% assign preacher = '""' %}
        {% else %}
          {% assign preacher = preacher_raw %}
        {% endif %}
      {% endif %}
      
      {% comment %}
      Extract Prayer Leader
      {% endcomment %}
      {% if roles_text contains "Prayer Leader:" %}
        {% assign prayer_leader_found = true %}
        {% assign prayer_raw = roles_text | split: "Prayer Leader:" | last | split: "
" | first | strip %}
        {% if prayer_raw == "TBD" or prayer_raw == """" or prayer_raw == "" %}
          {% assign prayer_leader = '""' %}
        {% else %}
          {% assign prayer_leader = prayer_raw %}
        {% endif %}
      {% endif %}
      
      {% comment %}
      Extract Communion Elder
      {% endcomment %}
      {% if roles_text contains "Communion Elder:" %}
        {% assign communion_elder_found = true %}
        {% assign communion_raw = roles_text | split: "Communion Elder:" | last | split: "
" | first | strip %}
        {% if communion_raw == "TBD" or communion_raw == """" or communion_raw == "" %}
          {% assign communion_elder = '""' %}
        {% else %}
          {% assign communion_elder = communion_raw %}
        {% endif %}
      {% endif %}
      
      {% comment %}
      Extract Announcements
      {% endcomment %}
      {% if roles_text contains "Announcements:" %}
        {% assign announcements_found = true %}
        {% assign ann_raw = roles_text | split: "Announcements:" | last | split: "Benediction:" | first | strip | replace: "
", "" %}
        {% if ann_raw == "TBD" or ann_raw == """" or ann_raw == "" %}
          {% assign announcements = '""' %}
        {% else %}
          {% assign announcements = ann_raw %}
        {% endif %}
      {% endif %}
      
      {% comment %}
      Extract Benediction
      {% endcomment %}
      {% if roles_text contains "Benediction:" %}
        {% assign benediction_found = true %}
        {% assign benediction_raw = roles_text | split: "Benediction:" | last | split: "Mission's Moment:" | first | strip | replace: "
", "" %}
        {% if benediction_raw == "TBD" or benediction_raw == """" or benediction_raw == "" %}
          {% assign benediction = '""' %}
        {% else %}
          {% assign benediction = benediction_raw %}
        {% endif %}
      {% endif %}
      
      {% comment %}
      Extract Mission's Moment
      {% endcomment %}
      {% if roles_text contains "Mission's Moment:" %}
        {% assign missions_moment_found = true %}
        {% assign mission_raw = roles_text | split: "Mission's Moment:" | last | split: "
" | first | strip %}
        {% if mission_raw == "TBD" or mission_raw == """" or mission_raw == "" %}
          {% assign missions_moment = '""' %}
        {% else %}
          {% assign missions_moment = mission_raw %}
        {% endif %}
      {% endif %}
      
      {% break %}
    {% endif %}
{% endfor %}

{% comment %}
Extract song data
{% endcomment %}
{% for item in plan.items %}
    {% if item.song or item.arrangement %}
      
      {% if first_song_found == false %}
        {% assign first_song_title = item.title %}
        {% assign first_song_found = true %}
      {% endif %}
      
      {% if item.description contains "Song of Anticipation" %}
        {% assign anticipation_title = item.title %}
        {% if item.arrangement %}
          {% assign anticipation_arrangement = item.arrangement.name %}
        {% endif %}
      {% endif %}
      
      {% assign last_song_title = item.title %}
    {% endif %}
{% endfor %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order of Service</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Calibri, Arial, sans-serif;
        font-size: 11pt;
        line-height: 1.5;
        margin: 0.5in;
        color: #000;
      }

      .page-title {
        text-align: center;
        font-size: 14pt;
        font-weight: bold;
        margin-bottom: 1.25rem;
      }

      .service-section {
        margin-top: 0.75rem;
        margin-bottom: 0.75rem;
      }

      .section-heading {
        font-weight: normal;
      }

      .song-title {
        margin-left: 2.5rem;
        font-style: italic;
      }

      .subnote {
        margin-left: 2.5rem;
        font-size: 0.95rem;
        color: #333;
      }

      .service-notes {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #ccc;
      }

      @media print {
        body {
          margin: 0.5in;
        }
        .service-section {
          page-break-inside: avoid;
        }
        .song-title {
          page-break-inside: avoid;
        }
      }
    </style>
</head>
<body>

    <div class="page-title">
      Order of Service • {% if plan.plan_times.size > 0 %}{{ plan.plan_times.first.starts_at | date: "%B %-d, %Y" }}{% endif %}
    </div>

    <div class="service-section section-heading">
      Prelude • Call to Worship • Recorded Music
    </div>

    <div class="service-section section-heading">
      Worship in Singing • Worship Team
    </div>

    {% if first_song_title %}
      <div class="song-title">{{ first_song_title }}</div>
    {% endif %}

    <div class="service-section section-heading">
      {% if worship_leader %}
        Welcome to Worship • {{ worship_leader }}
      {% else %}
        Welcome to Worship •
      {% endif %}
    </div>

    <div class="subnote">
      (Theme/Greeting)
    </div>

    <div class="service-section section-heading">
      Songs of Worship • Worship Team
    </div>

    {% assign worship_song_count = 0 %}
    {% for item in plan.items %}
      {% if item.song or item.arrangement %}
        {% assign worship_song_count = worship_song_count | plus: 1 %}
        
        {% comment %}
        Display songs that are:
        - Not the first song (worship_song_count > 1)
        - Not the Song of Anticipation
        - Not the last song (Song of Response)
        {% endcomment %}
        {% if worship_song_count > 1 and item.title != anticipation_title and item.title != last_song_title %}
          <div class="song-title">{{ item.title }}</div>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% comment %}
    Display Mission's Moment section only if found in notes
    {% endcomment %}
    {% if missions_moment_found %}
      <div class="service-section section-heading">
        Worship in Mission's Moment • {{ missions_moment }}
      </div>
    {% endif %}

    {% comment %}
    Display Prayer for the Church/Offering section only if found in notes
    {% endcomment %}
    {% if prayer_leader_found %}
      <div class="service-section section-heading">
        Prayer for the Church/Offering • {{ prayer_leader }}
      </div>
    {% endif %}

    <div class="service-section section-heading">
      Song of Anticipation • Worship Team
    </div>

    {% if anticipation_title %}
      <div class="song-title">
        {{ anticipation_title }}
        {% if anticipation_arrangement %}
          , {{ anticipation_arrangement }}
        {% endif %}
      </div>
    {% endif %}

    {% comment %}
    Display Message section only if found in notes
    {% endcomment %}
    {% if preacher_found %}
      <div class="service-section section-heading">
        Message: "" • {{ preacher }}
      </div>
    {% endif %}

    {% comment %}
    Display Communion Elder section only if found in notes
    {% endcomment %}
    {% if communion_elder_found %}
      <div class="service-section section-heading">
        Communion Elder • {{ communion_elder }}
      </div>
    {% endif %}

    <div class="service-section section-heading">
      Song of Response • Worship Team
    </div>

    {% if last_song_title %}
      <div class="song-title">{{ last_song_title }}</div>
    {% endif %}

    {% comment %}
    Display Announcements/Benediction section only if at least one is found in notes
    {% endcomment %}
    {% if announcements_found or benediction_found %}
      <div class="service-section section-heading">
        {% if announcements_found and benediction_found %}
          {% if announcements | strip == benediction | strip %}
            Announcements/Benediction • {{ announcements }}
          {% else %}
            Announcements/Benediction • {{ announcements | strip }}, {{ benediction | strip }}
          {% endif %}
        {% elsif announcements_found %}
          Announcements • {{ announcements }}
        {% elsif benediction_found %}
          Benediction • {{ benediction }}
        {% endif %}
      </div>
    {% endif %}

    <div class="service-notes section-heading">
      Service Notes:
    </div>

  </body>
</html>
